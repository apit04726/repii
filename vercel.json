{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/ads.txt",
      "dest": "/ads.txt"
    },
    {
      "src": "/api.php",
      "dest": "/api/api.php"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/api.php"
    },
    {
      "src": "/api",
      "dest": "/api/api.php"
    },
    {
      "src": "/download.php",
      "dest": "/api/download.php"
    },
    {
      "src": "/download/(.*)",
      "dest": "/api/download.php"
    },
    {
      "src": "/download",
      "dest": "/api/download.php"
    },
    {
      "src": "/privacy(\\.php)?",
      "dest": "/api/privacy.php"
    },
    {
      "src": "/terms(\\.php)?",
      "dest": "/api/terms.php"
    },
    {
      "src": "/contact(\\.php)?",
      "dest": "/api/contact.php"
    },
    {
      "src": "/about(\\.php)?",
      "dest": "/api/about.php"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
